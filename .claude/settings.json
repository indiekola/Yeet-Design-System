  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__use_figma",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/figma-guard.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/team-status.sh"
          }
        ]
      }
    ]
  }
}

{
  "$description": "Yeet Design System — единый источник токенов. Из этого файла `npm run tokens` генерирует CSS (Storybook), Swift (iOS / SwiftUI) и Kotlin (Android / Jetpack Compose). Цвета: \"#RRGGBB\" или \"#RRGGBB@alpha\"; ссылки: \"{группа.имя}\". Figma: коллекция «Yeet DS 2.0» (Light / Dark).",

  "primitive": {
    "blue-500": "#0100F4",
    "blue-300": "#5B5BFF",
    "red-500": "#FF4230",
    "red-400": "#FF5A4A",
    "neutral-0": "#FFFFFF",
    "neutral-50": "#F7F7F7",
    "neutral-500": "#777777",
    "neutral-1000": "#000000",
    "graphite-50": "#F5F5F7",
    "graphite-400": "#8E8E93",
    "graphite-850": "#26262B",
    "graphite-900": "#1A1A1E",
    "graphite-950": "#0F0F11"
  },

  "item": {
    "black": { "value": "#1A1A2E", "name": "Чёрный" },
    "grey": { "value": "#777777", "name": "Серый" },
    "white": { "value": "#FFFFFF", "name": "Белый" },
    "purple": { "value": "#6A00FF", "name": "Фиолетовый" },
    "pink": { "value": "#D900FF", "name": "Розовый" },
    "green": { "value": "#00D08B", "name": "Зелёный" },
    "blue": { "value": "#0100F4", "name": "Синий" },
    "yellow": { "value": "#FFD000", "name": "Жёлтый" },
    "orange": { "value": "#FF8800", "name": "Оранжевый" },
    "red": { "value": "#FF4230", "name": "Красный" },
    "beige": { "value": "#FFE1C7", "name": "Бежевый" },
    "brown": { "value": "#C26547", "name": "Коричневый" }
  },

  "color": {
    "Поверхности": {
      "bg-canvas": { "light": "{primitive.neutral-0}", "dark": "{primitive.graphite-950}", "role": "Фон экрана", "figma": "ui-colors/white" },
      "bg-elevated": { "light": "{primitive.neutral-0}", "dark": "{primitive.graphite-900}", "role": "Поднятые поверхности: tab-bar, sheet, dialog, hint", "figma": "ui-colors/elevated" },
      "bg-subtle": { "light": "{primitive.neutral-50}", "dark": "{primitive.graphite-850}", "role": "Карточки, поля, tertiary-кнопки", "figma": "ui-colors/light-grey" },
      "bg-inverse": { "light": "{primitive.neutral-1000}", "dark": "{primitive.graphite-50}", "role": "Snackbar, Secondary-кнопка, погода", "figma": "ui-colors/black" },
      "bg-overlay": { "light": "#000000@0.4", "dark": "#000000@0.6", "role": "Затемнение под модальным sheet", "figma": "ui-colors/overlay" }
    },
    "Контент": {
      "text-primary": { "light": "{primitive.neutral-1000}", "dark": "{primitive.graphite-50}", "role": "Основной текст и иконки", "figma": "ui-colors/black" },
      "text-secondary": { "light": "{primitive.neutral-500}", "dark": "{primitive.graphite-400}", "role": "Вторичный текст, лейблы, подписи", "figma": "ui-colors/grey" },
      "text-inverse": { "light": "{primitive.neutral-0}", "dark": "{primitive.graphite-950}", "role": "Текст на inverse-поверхности", "figma": "ui-colors/white" },
      "text-on-accent": { "light": "{primitive.neutral-0}", "dark": "{primitive.neutral-0}", "role": "Текст и иконки на accent / danger", "figma": "ui-colors/on-accent" },
      "text-accent": { "light": "{primitive.blue-500}", "dark": "{primitive.blue-300}", "role": "Акцентный текст, выбранное", "figma": "ui-colors/blue" },
      "text-danger": { "light": "{primitive.red-500}", "dark": "{primitive.red-400}", "role": "Ошибки, деструктивные действия", "figma": "ui-colors/red" }
    },
    "Акцент, обратная связь, линии": {
      "accent": { "light": "{primitive.blue-500}", "dark": "{primitive.blue-300}", "role": "Главное действие, выбранное, фокус", "figma": "ui-colors/blue" },
      "accent-soft": { "light": "#0100F4@0.1", "dark": "#5B5BFF@0.2", "role": "Фон выбранного чипса (Soft)", "figma": "ui-colors/blue-10%" },
      "danger": { "light": "{primitive.red-500}", "dark": "{primitive.red-400}", "role": "Удаление, ошибка, бейдж скидки", "figma": "ui-colors/red" },
      "danger-soft": { "light": "#FF4230@0.1", "dark": "#FF5A4A@0.18", "role": "Фон Destructive-кнопки", "figma": "ui-colors/red-10%" },
      "border-subtle": { "light": "#000000@0.1", "dark": "#F5F5F7@0.12", "role": "Обводки свотчей, гистограмма, фон неактивных точек", "figma": "ui-colors/black-10%" },
      "divider": { "light": "#000000@0.05", "dark": "#F5F5F7@0.08", "role": "Разделители строк в input-group и list-group", "figma": "divider (black @5%)" }
    }
  },

  "component": {
    "button-primary-bg": "{color.accent}",
    "button-primary-fg": "{color.text-on-accent}",
    "button-secondary-bg": "{color.bg-inverse}",
    "button-secondary-fg": "{color.text-inverse}",
    "button-tertiary-bg": "{color.bg-subtle}",
    "button-tertiary-fg": "{color.text-primary}",
    "button-inverse-bg": "{color.bg-elevated}",
    "button-inverse-fg": "{color.text-primary}",
    "button-ghost-bg": "transparent",
    "button-ghost-fg": "{color.text-primary}",
    "button-soft-bg": "{color.accent-soft}",
    "button-soft-fg": "{color.text-accent}",
    "button-destructive-bg": "{color.danger-soft}",
    "button-destructive-fg": "{color.text-danger}",
    "card-bg": "{color.bg-subtle}",
    "card-radius": "{radius.lg}",
    "sheet-bg": "{color.bg-elevated}",
    "sheet-radius": "{radius.xl}",
    "tab-bar-bg": "{color.bg-elevated}",
    "input-bg": "{color.bg-subtle}"
  },

  "space": [0, 1, 2, 4, 8, 12, 16, 20, 24, 28, 32, 40, 48, 52, 56, 64, 72],

  "radius": {
    "xs": { "value": 4, "use": "Хэндл sheet" },
    "sm": { "value": 12, "use": "Badge" },
    "md": { "value": 16, "use": "Snackbar, cap столбца графика" },
    "lg": { "value": 20, "use": "Карточки, поля, фото" },
    "xl": { "value": 32, "use": "Кнопки-капсулы, верх sheet, подсказка стилиста" },
    "bar": { "value": 48, "use": "Tab-bar" },
    "full": { "value": 999, "use": "Аватар, радио" }
  },

  "font": {
    "display": { "family": "Roboto Slab", "fallback": "Georgia, serif", "file": "RobotoSlab-Variable.ttf", "android": "roboto_slab_variable", "weights": [380, 400], "source": "Google Fonts · apache/robotoslab" },
    "text": { "family": "Inter", "fallback": "-apple-system, 'Helvetica Neue', Arial, sans-serif", "file": "Inter-Variable.ttf", "android": "inter_variable", "weights": [400, 500], "source": "Google Fonts · ofl/inter" }
  },

  "typography": {
    "h1": { "font": "display", "weight": 380, "size": 32, "lineHeight": 36, "letterSpacing": -1, "use": "Заголовки экранов" },
    "h2": { "font": "display", "weight": 400, "size": 24, "lineHeight": 28, "letterSpacing": -0.4, "use": "Секции, пустые состояния, числа" },
    "h3": { "font": "display", "weight": 400, "size": 19, "lineHeight": 24, "letterSpacing": -0.3, "use": "Заголовки sheet, диалогов, карточек" },
    "body": { "font": "text", "weight": 500, "size": 14, "lineHeight": 20, "letterSpacing": 0, "use": "Текст, кнопки, пункты списков" },
    "caption": { "font": "text", "weight": 400, "size": 12, "lineHeight": 16, "letterSpacing": 0, "use": "Подписи, мета-данные, бейджи" }
  },

  "shadow": {
    "floating": {
      "light": { "x": 0, "y": 8, "blur": 40, "color": "#000000@0.12" },
      "dark": { "x": 0, "y": 8, "blur": 40, "color": "#000000@0.5" },
      "use": "Tab-bar, FAB, hint, панель sheet"
    }
  },

  "layout": {
    "screen-width": 393,
    "screen-height": 852,
    "screen-gutter": 20,
    "status-bar-height": 62
  },

  "motion": {
    "duration": { "fast": 150, "base": 240, "300": 300 },
    "easing": { "standard": [0.2, 0, 0, 1], "out": [0, 0, 0.58, 1] },
    "spring": {
      "gentle": { "mass": 1, "stiffness": 100, "damping": 15, "duration": 1022, "figma": "Gentle" },
      "quick": { "mass": 1, "stiffness": 300, "damping": 20, "duration": 744, "figma": "Quick" },
      "bouncy": { "mass": 1, "stiffness": 600, "damping": 15, "duration": 958, "figma": "Bouncy" }
    },
    "transition": {
      "press": { "duration": "fast", "easing": "standard", "use": "Нажатие кнопки, scale 0.97" },
      "fade": { "duration": "base", "easing": "standard", "use": "Затухание краёв, тосты" },
      "collapse": { "duration": "300", "easing": "out", "use": "Фото сворачивается в шапку при скролле" },
      "page": { "duration": "300", "easing": "out", "use": "Листание образов и поводов по свайпу" },
      "nav": { "spring": "quick", "use": "Таб-бар уступает место FAB" },
      "stamp": { "spring": "bouncy", "use": "Штамп «Надеть» → отмечено" },
      "swap": { "spring": "gentle", "use": "Смена образа: превью ↔ коллаж" }
    }
  }
}
